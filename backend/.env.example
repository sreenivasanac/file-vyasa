# FileVyasa Environment Configuration
# Only API keys and secrets should be stored here.
# Non-secret settings are in config/settings.yaml

# LLM API Key (BYOK - Bring Your Own Key)
FILEVYASA_LLM_API_KEY=your-api-key-here

# Optional: Custom API base URL (if using a proxy or compatible endpoint)
# FILEVYASA_LLM_API_BASE=https://api.openai.com/v1
